# Copy this file to .env and fill in your values
# The server reads these automatically on startup

# Port to listen on (default: 3000)
PORT=3000

# DirectShow audio device name to capture from.
# Run this to list available devices:
#   ffmpeg -list_devices true -f dshow -i dummy 2>&1 | findstr "audio"
#
# VB-Cable (recommended):
AUDIO_DEVICE=CABLE Output (VB-Audio Virtual Cable)
#
# Stereo Mix (alternative):
# AUDIO_DEVICE=Stereo Mix (Realtek(R) Audio)

# Volume multiplier — only needed for Stereo Mix.
# Stereo Mix level follows system volume, so boost it here to compensate.
# Leave at 1 for VB-Cable (signal is always at full level).
VOLUME_BOOST=1
